@model IEnumerable<ASPSTUFF.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<h1>Customers List</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New Customer</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model) {
            <tr>
                <td>@customer.Name</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
            </tr>
        }
    </tbody>
</table>